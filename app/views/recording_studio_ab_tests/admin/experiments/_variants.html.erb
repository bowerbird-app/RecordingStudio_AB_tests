<div class="space-y-4" data-testid="ab-variants-panel">
  <% variant_rows = experiment.variants.order(:position, :key).map { |variant|
       {
         key: variant.key,
         name: variant.name,
         implementation_key: variant.implementation_key,
         control: variant.is_control? ? RecordingStudio.t("recording_studio.ab_tests.common.yes") : RecordingStudio.t("recording_studio.ab_tests.common.empty"),
         weight: variant.weight,
         id: variant.id,
         removable: experiment.draft? && !variant.is_control?
       }
     } %>

  <% if variant_rows.any? %>
    <%= render FlatPack::Table::Component.new(data: variant_rows, class: "text-sm") do |table| %>
      <% table.column(title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.columns.key")) { |row| row[:key] } %>
      <% table.column(title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.columns.name")) { |row| row[:name] } %>
      <% table.column(title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.columns.implementation")) { |row| row[:implementation_key] } %>
      <% table.column(title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.columns.control")) { |row| row[:control] } %>
      <% table.column(title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.columns.weight")) { |row| row[:weight] } %>
      <% table.column(title: "") do |row| %>
        <% if row[:removable] %>
          <%= form_with url: admin_experiment_variant_path(experiment, row[:id]), method: :delete, class: "inline" do %>
            <%= render FlatPack::Button::Component.new(text: RecordingStudio.t("recording_studio.ab_tests.common.remove"), style: :danger, type: "submit", size: :sm) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.empty_title"),
      description: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.empty_description")
    ) %>
  <% end %>

  <% if experiment.draft? %>
    <%= form_with url: admin_experiment_variants_path(experiment), method: :post, class: "space-y-3 border-t border-[var(--surface-border-color)] pt-4" do %>
      <p class="text-sm font-medium"><%= RecordingStudio.t("recording_studio.ab_tests.experiments.variants.add_heading") %></p>
      <%= render FlatPack::TextInput::Component.new(name: "variant[key]", label: RecordingStudio.t("recording_studio.ab_tests.common.key"), required: true) %>
      <%= render FlatPack::TextInput::Component.new(name: "variant[name]", label: RecordingStudio.t("recording_studio.ab_tests.common.name"), required: true) %>
      <%= render FlatPack::TextInput::Component.new(name: "variant[implementation_key]", label: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.implementation_key"), required: true) %>
      <%= render FlatPack::NumberInput::Component.new(name: "variant[weight]", label: RecordingStudio.t("recording_studio.ab_tests.common.weight"), value: 50, min: 0) %>
      <%= render FlatPack::NumberInput::Component.new(name: "variant[position]", label: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.position"), value: experiment.variants.size, min: 0) %>
      <%= render FlatPack::Button::Component.new(text: RecordingStudio.t("recording_studio.ab_tests.experiments.variants.add"), style: :secondary, type: "submit", size: :sm) %>
    <% end %>
  <% end %>
</div>
