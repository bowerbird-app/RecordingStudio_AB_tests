<% frozen = local_assigns.fetch(:frozen, false) %>
<% targets = local_assigns.fetch(:targets, []) %>
<% events = local_assigns.fetch(:events, []) %>

<div class="space-y-4" data-testid="ab-experiment-form">
  <%= render FlatPack::TextInput::Component.new(
    name: "experiment[name]",
    label: t("recording_studio.ab_tests.experiments.form.name"),
    value: experiment.name,
    required: true,
    error: experiment.errors[:name].presence&.to_sentence
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "experiment[description]",
    label: t("recording_studio.ab_tests.experiments.form.description"),
    value: experiment.description,
    rows: 3
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: "experiment[key]",
    label: t("recording_studio.ab_tests.experiments.form.key"),
    value: experiment.key,
    required: true,
    disabled: frozen,
    help_text: frozen ? t("recording_studio.ab_tests.experiments.form.key_frozen") : t("recording_studio.ab_tests.experiments.form.key_help"),
    error: experiment.errors[:key].presence&.to_sentence
  ) %>

  <% target_options = targets.map { |target| [target.label.to_s, target.key.to_s] } %>
  <%= render FlatPack::Select::Component.new(
    name: "experiment[target_key]",
    label: t("recording_studio.ab_tests.experiments.form.target"),
    options: target_options,
    value: experiment.target_key,
    required: true,
    disabled: frozen,
    searchable: true,
    error: experiment.errors[:target_key].presence&.to_sentence
  ) %>

  <%= render FlatPack::Select::Component.new(
    name: "experiment[assignment_scope]",
    label: t("recording_studio.ab_tests.experiments.form.assignment_scope"),
    options: RecordingStudioAbTests::Experiment::SCOPES.map { |scope| [scope.humanize, scope] },
    value: experiment.assignment_scope,
    required: true,
    disabled: frozen
  ) %>

  <%= render FlatPack::NumberInput::Component.new(
    name: "experiment[traffic_percentage]",
    label: t("recording_studio.ab_tests.experiments.form.traffic_percent"),
    value: experiment.traffic_percentage,
    min: 0,
    max: 100,
    required: true
  ) %>

  <% unless frozen || experiment.persisted? %>
    <div class="space-y-2" data-testid="ab-variant-picker">
      <p class="text-sm font-medium"><%= t("recording_studio.ab_tests.experiments.form.variants_heading") %></p>
      <p class="text-xs text-[var(--surface-muted-content-color)]">
        <%= t("recording_studio.ab_tests.experiments.form.variants_hint") %>
      </p>
      <input type="hidden" name="experiment[variant_keys][]" value="control" />
      <% targets.each do |target| %>
        <div class="rounded border border-[var(--surface-border-color)] p-3 space-y-2" data-target-key="<%= target.key %>">
          <p class="text-sm font-medium"><%= t("recording_studio.ab_tests.experiments.form.implementations", label: target.label) %></p>
          <% target.implementation_keys.each do |impl| %>
            <% is_control = impl == "control" %>
            <div class="flex flex-wrap items-end gap-3">
              <%= render FlatPack::Checkbox::Component.new(
                name: is_control ? "experiment[control_locked]" : "experiment[variant_keys][]",
                value: impl,
                checked: true,
                disabled: is_control,
                label: impl
              ) %>
              <%= render FlatPack::NumberInput::Component.new(
                name: "experiment[variant_weights][#{impl}]",
                label: t("recording_studio.ab_tests.experiments.form.weight"),
                value: 50,
                min: 0,
                max: 10_000
              ) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= render FlatPack::Select::Component.new(
      name: "experiment[primary_event_key]",
      label: t("recording_studio.ab_tests.experiments.form.primary_goal_event"),
      options: events.map { |event| [event.label.to_s, event.key.to_s] },
      value: nil,
      required: true,
      searchable: true
    ) %>

    <%= render FlatPack::NumberInput::Component.new(
      name: "experiment[attribution_window_hours]",
      label: t("recording_studio.ab_tests.experiments.form.attribution_window_hours"),
      value: 168,
      min: 1,
      max: 2160
    ) %>

    <%= render FlatPack::Select::Component.new(
      name: "experiment[counting_policy]",
      label: t("recording_studio.ab_tests.experiments.form.counting_policy"),
      options: RecordingStudioAbTests::Goal::COUNTING_POLICIES.map { |policy| [policy.humanize, policy] },
      value: "once_per_participant"
    ) %>
  <% end %>
</div>
