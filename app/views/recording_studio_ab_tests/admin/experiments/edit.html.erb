<% content_for :title, t("recording_studio.ab_tests.experiments.edit.page_title", name: @experiment.name) %>
<% frozen = !@experiment.draft? %>

<%= render FlatPack::PageHeader::Component.new(
  title: t("recording_studio.ab_tests.experiments.edit.title"),
  subtitle: t("recording_studio.ab_tests.experiments.edit.subtitle", key: @experiment.key, status: @experiment.status)
) %>

<% if flash[:alert].present? %>
  <%= render FlatPack::Alert::Component.new(title: t("recording_studio.ab_tests.experiments.edit.alert_title"), description: flash[:alert], style: :danger) %>
<% end %>

<% if frozen %>
  <%= render FlatPack::Alert::Component.new(
    title: t("recording_studio.ab_tests.experiments.edit.frozen_title"),
    description: t("recording_studio.ab_tests.experiments.edit.frozen_description"),
    style: :warning
  ) %>
<% end %>

<%= form_with model: @experiment, url: admin_experiment_path(@experiment), method: :patch, class: "space-y-6" do %>
  <%= render "form", experiment: @experiment, targets: @targets, events: @events, frozen: frozen %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(text: t("recording_studio.ab_tests.experiments.edit.save"), style: :primary, type: "submit") %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.ab_tests.common.cancel"),
      style: :secondary,
      href: admin_experiment_path(@experiment)
    ) %>
  </div>
<% end %>
