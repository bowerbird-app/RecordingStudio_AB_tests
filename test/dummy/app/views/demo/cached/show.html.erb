<%= render FlatPack::PageHeader::Component.new(
  title: "Cached fragment",
  subtitle: "Demo H — render_ab with cache: and ab_cache_vary (never visitor/user ids)"
) %>

<div class="mt-6 space-y-4">
  <% if @recording %>
    <% vary_preview = ab_cache_vary(:cached_hero) %>
    <p class="text-sm">Vary key: <code id="ab-vary-key"><%= vary_preview.inspect %></code></p>
    <div id="cached-fragment">
      <%= render_ab :cached_hero,
            cache: { recording: @recording, entry: :cached_hero, policy: :default } %>
    </div>
  <% else %>
    <p>No recording available for Cache demo.</p>
  <% end %>
</div>
